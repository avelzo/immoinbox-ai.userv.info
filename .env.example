APP_NAME=Immoinbox AI
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET="32-chars-secret-key-for-better-auth"
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=sk-
OPENAPI_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# MongoDB Configuration (local natif, replica set rs0)
DATABASE_HOST=127.0.0.1
DATABASE_NAME=immoinbox-ai
DATABASE_PORT=27017

# MongoDB local natif (replica set rs0) — npm run dev
DATABASE_URL="mongodb://127.0.0.1:${DATABASE_PORT}/${DATABASE_NAME}?replicaSet=rs0"

ENCRYPTION_SECRET="une-cle-tres-longue-pour-chiffrer-les-secrets"