        "jsonBody": "={{\n  {\n    organizationId: '6a02026cc7614ba0caf62450',\n    mailboxId: '6a3ae4e8ddd4a84509075a9f',\n    subject: $json.subject,\n    from: $json.from?.text || $json.from,\n    to: ['immo@userv.info'],\n    content: $json.text || $json.html || $json.textHtml || '',\n    externalMessageId: $json.messageId || $json.metadata?.['message-id'] || ''\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-40, 0],
      "id": "0c491c4a-badc-4eba-819a-9c869830216b",
      "name": "Envoyer à ImmoInbox API"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "intervention-exists",
              "leftValue": "={{ $json.intervention }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 0],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Intervention créée ?"
